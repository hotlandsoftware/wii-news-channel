// C++-style wrapper so sources ported from other decomps can #include <cmath>.
// The declarations stay in the global namespace (the SDK sources are C).
#include <math.h>

// Added for g3d (Task 10): as in MSL's math_double.h (std::ldexpf)
#ifdef __cplusplus
#ifndef CMATH_STD_LDEXPF
#define CMATH_STD_LDEXPF
namespace std {
inline float ldexpf(float value, int exp) {
    return ldexp(value, exp);
}
} // namespace std
#endif
#endif

// Added for nw4r::ef (Task 9): MSL's float wrappers (math_double.h) and the
// std::fabs(float) of MSL <cmath>, as ogws's ef sources use them.
#ifdef __cplusplus
#ifndef CMATH_STD_FLOAT_WRAPPERS
#define CMATH_STD_FLOAT_WRAPPERS
namespace std {
inline float acosf(float x) {
    return acos(x);
}
inline float asinf(float x) {
    return asin(x);
}
inline float atan2f(float x, float y) {
    return atan2(x, y);
}
inline float cosf(float x) {
    return cos(x);
}
inline float sinf(float x) {
    return sin(x);
}
inline float sqrtf(float x) {
    return sqrt(x);
}
inline float tanf(float x) {
    return tan(x);
}
inline float fmodf(float x, float y) {
    return fmod(x, y);
}
inline double fabs_wrapper(double x) {
    return __fabs(x);
}
inline float fabs(float x) {
    return fabs_wrapper(x);
}
} // namespace std
#endif
#endif
