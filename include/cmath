// C++-style wrapper so sources ported from other decomps can #include <cmath>.
// The declarations stay in the global namespace (the SDK sources are C).
#include <math.h>

// Added for g3d (Task 10): as in MSL's math_double.h (std::ldexpf)
#ifdef __cplusplus
#ifndef CMATH_STD_LDEXPF
#define CMATH_STD_LDEXPF
namespace std {
inline float ldexpf(float value, int exp) {
    return ldexp(value, exp);
}
} // namespace std
#endif
#endif

// Added for nw4r::ef: as in MSL (std::sinf/cosf/sqrtf call the double versions)
#ifdef __cplusplus
#ifndef CMATH_STD_SINF
#define CMATH_STD_SINF
namespace std {
inline float sinf(float x) {
    return sin(x);
}
inline float cosf(float x) {
    return cos(x);
}
inline float sqrtf(float x) {
    return sqrt(x);
}
} // namespace std
#endif
#endif
