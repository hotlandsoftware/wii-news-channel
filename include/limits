#ifndef MSL_CPP_LIMITS_H
#define MSL_CPP_LIMITS_H
// Minimal <limits> (as ogws include/MSL/limits), added for nw4r::ef
#include <limits.h>

#ifndef FLT_EPSILON
#define FLT_EPSILON 1.19209289550781e-7f
#endif

#ifdef __cplusplus

namespace std {

template <typename T> class numeric_limits {
public:
    static const T epsilon() {
        return T();
    }
};

template <> class numeric_limits<float> {
public:
    static const float epsilon() {
        return FLT_EPSILON;
    }
};

} // namespace std

#endif
#endif
